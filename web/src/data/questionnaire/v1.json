{
  "version": 2,
  "title": "A few things about you",
  "intro": "Blurt uses these answers as Memory. You can correct them any time by blurting.",
  "items": [
    {
      "id": "waking",
      "kind": "timeRange",
      "prompt": "When do you usually wake up and go to sleep?",
      "description": "Blurt keeps reminders inside these hours unless you say otherwise.",
      "labels": ["Wake", "Sleep"],
      "defaults": ["07:00", "23:00"]
    },
    {
      "id": "work_days",
      "kind": "choice",
      "prompt": "Which days do you usually work?",
      "default": "weekdays",
      "choices": [
        { "value": "weekdays", "label": "Weekdays" },
        { "value": "every_day", "label": "Every day" },
        { "value": "some_days", "label": "Some days" },
        { "value": "not_working", "label": "Not working right now" }
      ]
    },
    {
      "id": "work",
      "kind": "timeRange",
      "prompt": "When do you usually work?",
      "description": "Roughly is fine. You can change this later.",
      "labels": ["Start", "End"],
      "defaults": ["09:00", "18:00"]
    },
    {
      "id": "work_place",
      "kind": "choice",
      "prompt": "Where do you usually work?",
      "default": "home",
      "choices": [
        { "value": "home", "label": "At home" },
        { "value": "office", "label": "At an office" },
        { "value": "hybrid", "label": "A mix of both" },
        { "value": "on_the_move", "label": "On the move" }
      ]
    },
    {
      "id": "home_area",
      "kind": "text",
      "prompt": "Where is home?",
      "description": "Just the area or neighbourhood is enough.",
      "placeholder": "Tampines",
      "required": false
    },
    {
      "id": "commute",
      "kind": "choice",
      "prompt": "How do you usually get around?",
      "default": "mrt",
      "choices": [
        { "value": "mrt", "label": "MRT or bus" },
        { "value": "car", "label": "Drive" },
        { "value": "walk_bike", "label": "Walk or cycle" },
        { "value": "mixed", "label": "A mix" }
      ]
    },
    {
      "id": "quiet",
      "kind": "timeRange",
      "prompt": "When should Blurt stay quiet?",
      "description": "No nudges during this window, unless something is urgent.",
      "labels": ["Quiet from", "Quiet until"],
      "defaults": ["22:00", "07:00"]
    }
  ]
}
