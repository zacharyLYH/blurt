{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    // Both trees resolve under both @types: the e2e specs import node builtins, so a project
    // configured without "node" reports every `node:*` import as missing. tsconfig.e2e.json
    // now adds nothing to this and exists only as a narrower entry point.
    "types": ["node", "vite/client"]
  },
  "include": ["src", "e2e"]
}
