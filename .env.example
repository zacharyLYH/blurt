# Template for .env. `make env-init` copies this file and fills in the
# generated secrets. The backend panics on boot if a required value is
# missing, so a half-configured deploy never runs.
#
# BLURT_PUBLIC_ORIGINS is a comma-separated CSRF allowlist. Leave it empty for
# local dev (localhost:9998 and :5173 are used). When set, only the listed
# origins are trusted, so add localhost explicitly if you run both.
BLURT_PUBLIC_ORIGINS=

# DEV ONLY. Login accepts the fixed PIN 123456 and no mail is sent, so a local
# stack needs no mailbox. Never set this on a public host.
# BLURT_FAKE_PIN=true

BLURT_DATA_DIR=/data
BLURT_BIND=:8080

# >= 32 characters. Signs/hashes opaque HttpOnly session cookies.
BLURT_SESSION_SECRET=
# base64 of exactly 32 bytes. AES-256 key for model API keys at rest.
BLURT_ENCRYPTION_KEY=

# Login PIN mail. Optional in this file but required by the production server:
# it refuses to boot without a usable mailbox. For Gmail use an App Password
# (2FA required), not the account password. Nothing else to configure: Go
# verifies the mail server against the OS trust store.
BLURT_SMTP_HOST=smtp.gmail.com
BLURT_SMTP_PORT=587
BLURT_SMTP_USERNAME=leeyihong03@gmail.com
BLURT_SMTP_PASSWORD=
BLURT_SMTP_FROM=leeyihong03@gmail.com

# Web Push (VAPID) identity, generated by `make env-init`.
BLURT_VAPID_PUBLIC_KEY=
BLURT_VAPID_PRIVATE_KEY=
BLURT_VAPID_SUBJECT=mailto:leeyihong03@gmail.com

# Speech-to-text (phonon). Blurt calls the gateway's own route, which is not
# OpenAI's: a base64 WAV data URI in, {"output": {"text": "..."}} out. The model
# id is checked by the gateway, so it must be the one it serves. Required
# unless the dev fake is on.
BLURT_STT_URL=
# Bearer key for the gateway. Any other value is refused with a 401, so this
# must be the live key; never commit it.
BLURT_STT_API_KEY=
BLURT_STT_MODEL=phonon

# DEV ONLY. true swaps the gateway for a deterministic transcriber, so a local
# stack needs no model at all. Never set on a public host.
# BLURT_FAKE_STT=true
